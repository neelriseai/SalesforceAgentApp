# Optional external-agent configuration template. Not read by the supplied CLI scripts.
# URLs/usernames are environment-specific. Keep real values in ignored .env or your secret store.
SF_ORG_ALIAS=caip-dev
SF_VP_ORG_ALIAS=caip-vp
SF_AUTH_METHOD=cli
# Approved MVP: the local CLI alias brokers API, scoped metadata and ephemeral browser sessions.
# Reauthorize privately with `sf org login web` when Salesforce expires the session.
SF_API_VERSION=67.0
SF_INSTANCE_URL=
SF_LIGHTNING_URL=
SF_AUTH_PROFILE_REF=
# For unattended JWT, store only secret-manager references here; never private keys/tokens.
SF_JWT_CLIENT_ID_REF=
SF_JWT_USERNAME_REF=
SF_JWT_KEY_REF=
SF_SUBMITTER_USERNAME=
SF_APPROVER_USERNAME=
SF_ALLOWED_NAME_PREFIX=SYN-
SF_ALLOW_WRITES=false
